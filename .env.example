# ── Market data ──────────────────────────────────────────────────────────
# Optional — richer news headlines for "Why is this moving" and the
# historical headlines behind "Explain the Jump" (free tier archives ~1yr).
# Get a free key at https://finnhub.io/register (60 calls/min free tier).
# Without a key the app falls back to Yahoo Finance news (no key required).
FINNHUB_API_KEY=

# ── Auth / sessions ──────────────────────────────────────────────────────
# Secret for signing session + quota cookies. Any long random string:
#   openssl rand -hex 32
# Falls back to an insecure dev default when unset.
AUTH_SECRET=

# ── Stripe (Pro subscriptions) ───────────────────────────────────────────
# Optional — without these, the "Upgrade" button applies a clearly-labeled
# demo upgrade so the whole Pro flow still works locally.
# Test-mode keys from https://dashboard.stripe.com/test/apikeys, and a
# recurring Price (e.g. $5/mo) from Products → Add product.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Only needed if you configure a webhook endpoint (Developers → Webhooks,
# pointing at /api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=

# ── Newsletter ───────────────────────────────────────────────────────────
# Optional — Buttondown API key (Settings → API) for real signups.
# Without it, signups succeed in demo mode and are only logged.
BUTTONDOWN_API_KEY=
